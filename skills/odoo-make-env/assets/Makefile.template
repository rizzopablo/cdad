# Makefile.template — contrato make Odoo (odoo-make-env)

# Variables to resolve per environment (placeholders):
#   ODB     = odoo binary (e.g. `odoo-bin`, `venv/bin/python3 src/odoo-bin`,
#             `docker compose exec odoo odoo`)
#   CONF    = test config file (e.g. `odoo-test.conf`); in managed
#             environments like odoo.sh it may be unnecessary (drop -c).
#   TEST_DB = test DB name (on odoo.sh: $PGDATABASE, the only DB).
#   test-clean MECHANISM: see the variance table in SKILL.md. This shows
#             the "fresh DB" variant (private staging/docker); for odoo.sh replace
#             with: psql -c "UPDATE ir_module_module SET state='to install'
#             WHERE name='<module>';" + -i.

MODULE ?= <module>
ODB    ?= odoo-bin
CONF   ?= odoo-test.conf
TEST_DB ?= <test_db_name>

.PHONY: test test-one test-clean

test:
	$(ODB) -c $(CONF) -d $(TEST_DB) -u $(MODULE) --test-enable --stop-after-init --workers 0 --max-cron-threads 0 --log-level=test

test-one:
	@test -n "$(TEST)" || (echo "Required: TEST=module:Class.method" && exit 1)
	$(ODB) -c $(CONF) -d $(TEST_DB) -u $(MODULE) --test-enable --test-tags $(TEST) --stop-after-init --workers 0 --max-cron-threads 0 --log-level=test

test-clean:
	-dropdb --if-exists $(TEST_DB) 2>/dev/null || true
	createdb $(TEST_DB)
	$(ODB) -c $(CONF) -d $(TEST_DB) -i $(MODULE) --test-enable --stop-after-init --workers 0 --max-cron-threads 0 --log-level=test
