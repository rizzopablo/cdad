[options]
# Project's own TEST conf (odoo-make-env).
# In managed environments (private staging, odoo.sh) do NOT edit the platform conf:
# use this file only for the make runs.
db_host = localhost
db_port = 5432
db_user = <db_user>
# In setups with trust auth (local PG) this line is ignored; if your PG requires
# auth, use PGPASSWORD or ~/.pgpass instead of committing the value.
db_password = <db_password>
db_name = <test_db_name>
dbfilter = ^<test_db_name>$
list_db = False
http_port = <free_port>
addons_path = <odoo_addons>,<custom_modules_dir>
logfile = <logfile_test>
# Courtesy toward multi-tenant shared postgres:
workers = 0
max_cron_threads = 0
db_maxconn = 5
limit_time_real = 600
