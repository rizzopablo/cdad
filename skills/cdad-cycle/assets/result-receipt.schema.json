{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDAD result receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "packet_id", "feature_id", "role", "substage", "source", "parts", "bundle_sha256", "packet_validation", "identity_validation", "scope_validation", "run_evidence_status", "semantic_status", "state_transition_requested", "received_at"],
  "properties": {
    "schema_version": {"const": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "feature_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["architect", "test-writer", "implementer", "reviewer", "scribe"]},
    "substage": {"enum": ["discovery", "brainstorm", "draft", "audit", "post-audit", "red", "properties", "e2e", "green", "refactor", "review-fix", "review", "plan-review", "memory"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "staged-file"},
        "sdk_message_ref": {"type": ["string", "null"]}
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "artifact_kind", "sha256", "bytes", "stored_ref"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "artifact_kind": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "stored_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_validation": {"const": "passed"},
    "identity_validation": {"const": "passed"},
    "scope_validation": {"enum": ["passed", "failed", "unknown"]},
    "run_evidence_status": {"enum": ["valid-current", "invalid", "stale", "not-provided"]},
    "semantic_status": {"const": "pending"},
    "state_transition_requested": {"const": "received"},
    "received_at": {"type": "string", "minLength": 1}
  }
}
