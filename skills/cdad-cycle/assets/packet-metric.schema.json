{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDAD packet metric",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "packet_id", "epic_id", "feature_id", "role", "substage", "runtime", "model", "started_at", "ended_at", "input_tokens", "output_tokens", "context_limit", "retry_count", "outcome"],
  "properties": {
    "schema_version": {"const": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "epic_id": {"type": "string", "minLength": 1},
    "feature_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "substage": {"type": "string", "minLength": 1},
    "runtime": {"type": "string", "minLength": 1},
    "model": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "context_limit": {"type": ["integer", "null"], "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["prepared", "dispatched", "completed", "failed"]}
  }
}
