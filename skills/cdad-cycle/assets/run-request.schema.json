{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDAD supported runner request (003-002 §8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "packet_id",
    "argv",
    "source_selection",
    "test_selection",
    "contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "argv": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "source_selection": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "test_selection": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
