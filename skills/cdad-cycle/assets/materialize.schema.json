{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cdad-materialize.schema.json",
  "title": "CDAD explicit materialization authorization (003-002 §7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "packet_id",
    "receipt_sha256",
    "authorized_by",
    "authority_ref",
    "approval_effect",
    "copies"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "execution_id": {"type": "string"},
    "packet_id": {"type": "string"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorized_by": {"type": "string", "minLength": 1},
    "authority_ref": {"type": "string", "minLength": 1},
    "approval_effect": {"const": false},
    "copies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part", "target", "expected_previous_sha256"],
        "properties": {
          "part": {"type": "string"},
          "target": {"type": "string"},
          "expected_previous_sha256": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          }
        }
      }
    }
  }
}
