{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDAD rendered packet metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_version", "packet_id", "execution_id", "feature_id", "role", "substage", "contract", "read_scope", "write_scope", "execution", "path_policy", "instruction_sources"],
  "properties": {
    "packet_version": {"const": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "feature_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "substage": {"type": "string", "minLength": 1},
    "contract": {"type": "object"},
    "read_scope": {"type": "array"},
    "write_scope": {"type": "array"},
    "execution": {"type": "object"},
    "path_policy": {"type": "object"},
    "instruction_sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
