{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDAD result bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "packet_id", "feature_id", "parts"],
  "properties": {
    "schema_version": {"const": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "feature_id": {"type": "string", "minLength": 1},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "artifact_kind", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "artifact_kind": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
