{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDAD supported runner evidence (003-002 §8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "packet_id",
    "argv",
    "cwd",
    "exit",
    "tests_run",
    "failures",
    "errors",
    "skipped",
    "runner_exceptions",
    "log",
    "source_selection",
    "test_selection",
    "contract_sha256",
    "snapshots",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "argv": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "cwd": {"type": "string"},
    "exit": {"type": "integer"},
    "tests_run": {"type": "integer", "minimum": 0},
    "failures": {"type": "integer", "minimum": 0},
    "errors": {"type": "integer", "minimum": 0},
    "skipped": {"type": "integer", "minimum": 0},
    "runner_exceptions": {"type": "integer", "minimum": 0},
    "log": {"type": "string"},
    "source_selection": {"type": "array", "items": {"type": "string"}},
    "test_selection": {"type": "array", "items": {"type": "string"}},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/snapshot"},
        "after": {"$ref": "#/$defs/snapshot"}
      }
    },
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "entries"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
