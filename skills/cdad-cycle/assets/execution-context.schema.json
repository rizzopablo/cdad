{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdad.dev/schemas/execution-context.schema.json",
  "title": "CDAD execution context",
  "type": "object",
  "required": ["schema_version", "execution", "path_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "execution": {
      "type": "object",
      "required": ["id", "epic_id", "feature_id", "runtime", "scope", "model_policy", "authority_ref", "model"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "epic_id": {"type": "string", "minLength": 1},
        "feature_id": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "model_policy": {"type": "string", "minLength": 1},
        "authority_ref": {"type": "string", "minLength": 1},
        "model": {
          "type": "object",
          "required": ["configured", "reported"],
          "properties": {
            "configured": {"type": ["string", "null"]},
            "reported": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "path_policy": {"type": "object"}
  },
  "additionalProperties": false
}
